PORT=8899
APP_BASE_URL=http://localhost:8899

# PostgreSQL connection string (required)
DATABASE_URL=postgres://user:password@host:5432/dbname
# Set DATABASE_SSL=true if your host requires SSL
DATABASE_SSL=false

# Only this email can access the admin dashboard
SUPERADMIN_EMAIL=your-email@example.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_AUTH_URL=https://api.prod.whoop.com/oauth/oauth2/auth
WHOOP_TOKEN_URL=https://api.prod.whoop.com/oauth/oauth2/token
WHOOP_API_BASE=https://api.prod.whoop.com/developer/v2
WHOOP_SCOPE=offline read:profile read:recovery read:sleep read:workout read:cycles read:body_measurement
WHOOP_REDIRECT_URI=http://localhost:8899/auth/whoop/callback

# SMTP for password reset emails (optional — if not set, code is logged to server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Bekalo Hub <noreply@yourapp.com>"
